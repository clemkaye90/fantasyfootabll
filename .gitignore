# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Local secrets (API keys) - never commit. See .streamlit/secrets.toml.example
.streamlit/secrets.toml

# Regenerated from corpus/ via scripts/export_txt_for_lyzr.py -- same
# content, just .txt instead of .md for Lyzr's uploader. Not worth
# duplicating in git history.
corpus_txt/

# NOT ignored: src/nfl_fantasy_app/data/spread_snapshots.db. It used to be
# treated as purely local, locally-growing state, but the deployed
# Streamlit Cloud app has no persistent filesystem of its own -- so a
# daily GitHub Actions job (.github/workflows/capture_spread_snapshot.yml)
# now commits it back to the repo instead, and that commit is what keeps
# the deployed app's spread data current. A local Task Scheduler run will
# now show up as a normal tracked change too; commit and push it like any
# other edit if you want a local capture to reach the deployed app sooner
# than the next scheduled Action run.
logs/
