# Copy this file to secrets.toml (gitignored) and fill in your real key.
# Get a key at https://secure.fantasypros.com/api-keys/request/
#
# On Streamlit Community Cloud, don't upload this file at all — instead paste
# the same key/value into the app's "Settings -> Secrets" box in the dashboard.
fantasypros_api_key = "YOUR_API_KEY_HERE"

# Draft assistant (Lyzr agent) -- from Lyzr Studio's Deploy tab, Agent API
# panel: x-api-key is lyzr_api_key, agent_id and user_id come from the
# sample curl command's request body.
lyzr_api_key = "YOUR_LYZR_API_KEY_HERE"
lyzr_agent_id = "YOUR_LYZR_AGENT_ID_HERE"
lyzr_user_id = "YOUR_LYZR_ACCOUNT_EMAIL_HERE"

# Picks tab (data/picks.py) -- backed by a Google Sheet instead of a local
# file, since Streamlit Community Cloud's filesystem is ephemeral and would
# lose anything saved there on the next restart/redeploy. One-time setup:
#
# 1. Create the spreadsheet: a new Google Sheet, with ONE tab literally
#    named "picks" (the connector won't create it for you). In that tab's
#    row 1, put these exact headers:
#      person | season | week | pick_type | game_id | selected_team | saved_at
#    Leave every other row blank -- the app fills them in.
#
# 2. Create a Google Cloud service account (a robot account the app signs
#    in as, so no human's Google login is ever involved):
#      a. https://console.cloud.google.com/ -> create a project (or reuse one).
#      b. APIs & Services -> Library -> enable "Google Sheets API" AND
#         "Google Drive API".
#      c. APIs & Services -> Credentials -> Create Credentials -> Service
#         Account -> give it any name (e.g. "picks-tab") -> Create and
#         Continue -> Done (no roles/access needed).
#      d. Click into that new service account -> Keys tab -> Add Key ->
#         Create new key -> JSON -> Create. A .json file downloads.
#
# 3. Share the spreadsheet: open the Sheet, click Share, and paste in the
#    service account's email address (the "client_email" field in the
#    downloaded JSON, looks like ...@...iam.gserviceaccount.com) with
#    Editor access.
#
# 4. Fill in the values below from that downloaded JSON file (same field
#    names) plus the spreadsheet's own URL. On Streamlit Community Cloud,
#    paste this whole [connections.gsheets] block into the app's
#    "Settings -> Secrets" box instead of uploading this file.
[connections.gsheets]
spreadsheet = "YOUR_GOOGLE_SHEET_URL_HERE"
type = "service_account"
project_id = "YOUR_PROJECT_ID_HERE"
private_key_id = "YOUR_PRIVATE_KEY_ID_HERE"
private_key = "YOUR_PRIVATE_KEY_HERE"
client_email = "YOUR_SERVICE_ACCOUNT_EMAIL_HERE"
client_id = "YOUR_CLIENT_ID_HERE"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "YOUR_CLIENT_X509_CERT_URL_HERE"
